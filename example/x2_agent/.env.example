# 豆包（火山引擎）Key 配置 —— 复制为 .env 并填入实际值，不要加引号

# 语音控制台 → API Key 管理（ASR + TTS 共用）
DOUBAO_SPEECH_API_KEY=

# 火山方舟控制台 → API Key 管理（LLM）
ARK_API_KEY=

# ---- 可选项（不填用默认值）----

# LLM 模型：方舟完整模型 ID（必须带日期后缀），或你的接入点 ep-2024xxxx
# 实测可用：doubao-seed-2-0-mini-260428 / doubao-seed-2-0-mini-260215
#DOUBAO_LLM_MODEL=doubao-seed-2-0-mini-260428

# TTS 音色：必须与 seed-tts-1.0 资源匹配的 1.0 音色（2.0 音色会 403 资源不匹配）
#DOUBAO_TTS_SPEAKER=zh_female_wanqudashu_moon_bigtts

# ASR 资源：小时版 volc.bigasr.sauc.duration / 并发版 volc.bigasr.sauc.concurrent
#DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
